{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "newwave",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGIN": "*"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
